<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Cucumber scenarios, 3 at a time. Run: mvn clean test -DsuiteXmlFile=suites/cucumber-parallel.xml -->
<suite name="Cucumber Parallel Suite" data-provider-thread-count="3" verbose="1">
    <test name="Cucumber Parallel">
        <classes>
            <class name="com.username.cucumber.runners.CucumberRunnerTest"/>
        </classes>
    </test>
</suite>
