<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Parallel run: 3 test methods at a time, each with its own browser (ThreadLocal driver).
     Run: mvn clean test -DsuiteXmlFile=suites/parallel.xml -->
<suite name="Parallel Suite" parallel="methods" thread-count="3" data-provider-thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.username.listeners.RetryTransformer"/>
    </listeners>
    <test name="Parallel Regression">
        <classes>
            <class name="com.username.tests.LoginTest"/>
            <class name="com.username.tests.LoginDataDrivenTest"/>
            <class name="com.username.tests.ProductsTest"/>
            <class name="com.username.tests.CheckoutTest"/>
            <class name="com.username.tests.PracticeTest"/>
        </classes>
    </test>
</suite>
